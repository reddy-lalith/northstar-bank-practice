{
  "name": "Northstar Bank",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:1-20-bookworm",
  "postCreateCommand": "npm install && npm install -g @anthropic-ai/claude-code",
  "forwardPorts": [5173, 4000],
  "portsAttributes": {
    "5173": { "label": "Web app", "onAutoForward": "openPreview" },
    "4000": { "label": "API", "onAutoForward": "silent" }
  },
  "customizations": {
    "codespaces": {
      "openFiles": ["practice/START_HERE.md"]
    }
  }
}
